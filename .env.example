# Переменные окружения приложения. Реальные значения в репозиторий не кладём —
# для сборки они приходят из GitHub Secrets (веб и OTA) и из переменных
# окружения EAS (сборка бинарников).
#
# Запасных значений в коде больше нет: если переменная не задана, соответствующая
# часть просто не работает. Так задумано — забытый в коде ключ переживает любую
# смену ключей и продолжает работать втихую.

# ── Обязательные ────────────────────────────────────────────────────────────

# Адрес PHP-прокси. Через него идёт всё общение с базой.
EXPO_PUBLIC_API_URL=https://jobtoo.ru

# Пропуск к db.php (заголовок X-App-Secret). Публичен по природе: попадает в
# бандл сайта. Тот же самый должен лежать в app_secrets.php на хостинге.
EXPO_PUBLIC_APP_SECRET=

# Supabase. Нужны только для живых обновлений чата (Realtime) и загрузки
# файлов в Storage — всё остальное ходит через прокси.
# Ключ публикуемый (sb_publishable_…), не секретный.
#
# Бэкенд self-hosted в Москве (РФ): свой домен, а не облачный проект
# *.supabase.co — ПДн российских пользователей должны храниться в РФ (152-ФЗ
# ст. 18(5), см. docs/rkn-подготовка.md). nginx на сервере проксирует
# /rest, /realtime, /storage в контейнеры (infra/docker-compose.yml).
EXPO_PUBLIC_SUPABASE_URL=https://jobtoo.ru
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Необязательные ──────────────────────────────────────────────────────────

# Ключ JavaScript API Яндекс.Карт. Неизбежно попадает в бандл, поэтому
# защита у него одна — ограничение по домену в кабинете Яндекса.
# Не задан — карта не покажется, остальное работает.
EXPO_PUBLIC_YANDEX_MAPS_KEY=

# Адрес дашборда (пуши в вебе ходят через его API).
# Дашборд работает на self-hosted сервере в Москве.
EXPO_PUBLIC_DASHBOARD_URL=https://admin.jobtoo.ru


# Закрытый read-only кабинет партнёров. Ключ — токен, значение ограничивает
# доступ одним source_id. Хранить только в серверном окружении дашборда.
PARTNER_PORTAL_TOKENS_JSON={"replace-with-long-random-token":{"sourceId":"yandex-smena","name":"Яндекс Смена"}}

# Один и тот же длинный случайный секрет задаётся в окружении admin.jobtoo.ru
# и GitHub Actions secret CRON_SECRET для месячного отчёта.
CRON_SECRET=
