# Локальная веб-сборка для снимков экранов (scripts/shoot-screens.mjs)
.figma-export/

# Сырые ответы первого партнёра могут содержать токены и ПДн. Они сначала
# попадают только в локальный staging; в git разрешены лишь обезличенные fixtures.
.partner-intake/

# Питон складывает разобранные модули рядом с исходником — появляется, как
# только что-нибудь из infra/ загружают модулем
__pycache__/
*.pyc

# Секреты — живут только на хостинге, в репозиторий не попадают
php-proxy/sb_service_key.php
php-proxy/admin_credentials.php
php-proxy/app_secrets.php
php-proxy/sb_url.php
php-proxy/deploy_token.php
php-proxy/studio_credentials.php
php-proxy/gh_token.php
php-proxy/backup_s3.php

# Ключ шифрования пуш-токенов. Его создаёт сам сервер при первом запуске
# push_privacy.php — в том числе когда db.php подключают локально. Файл
# секретный и машинный: в репозиторий ему нельзя, а попасть туда он может
# незаметно, одним `git add -A`.
php-proxy/push_token_key.php
