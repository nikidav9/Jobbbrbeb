{
  "expo": {
    "name": "JobToo",
    "slug": "jobtoo",
    "owner": "nikidav23",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jobtoo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobtoo",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Разрешите сохранять фотографии в галерею"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jobtoo",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "path": "/"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/ext-vacancy"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/perm-vacancy-detail"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/login"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/register-worker"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/legal"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/mail"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/jupiter-application"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/jupiter-captcha"
            },
            {
              "scheme": "https",
              "host": "jobtoo.ru",
              "pathPrefix": "/jupiter-questions"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "name": "JobToo",
      "shortName": "JobToo",
      "description": "Работа в Москве — свайпайте и откликайтесь",
      "themeColor": "#FF6B1A",
      "backgroundColor": "#ffffff",
      "preferRelatedApplications": false
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B1A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-dot.png",
          "imageWidth": 18,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE6"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешите доступ к микрофону, чтобы записывать голосовые сообщения в чате"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фото, чтобы добавить аватар и отправлять фотографии в чате",
          "cameraPermission": "Разрешите доступ к камере, чтобы сделать фото для профиля"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09b20cae-1be8-4f96-ae8a-b7675976c166"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/09b20cae-1be8-4f96-ae8a-b7675976c166",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
