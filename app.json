{
  "expo": {
    "name": "JobToo",
    "slug": "onspace-app",
    "owner": "nikidav23",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/jt-logo.png",
    "scheme": "onspaceapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nikidav23.onspaceapp",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Разрешите сохранять фотографии в галерею"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/jt-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nikidav23.onspaceapp",
      "versionCode": 7,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/jt-logo.png",
      "name": "JobToo",
      "shortName": "JobToo",
      "description": "Работа в Москве — свайпайте и откликайтесь",
      "themeColor": "#FF6B1A",
      "backgroundColor": "#ffffff",
      "preferRelatedApplications": false
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B1A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF6B1A"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешите доступ к микрофону, чтобы записывать голосовые сообщения в чате"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фото, чтобы добавить аватар и отправлять фотографии в чате",
          "cameraPermission": "Разрешите доступ к камере, чтобы сделать фото для профиля"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b26bb1e-9e73-4d94-8907-b27e3f66096f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5b26bb1e-9e73-4d94-8907-b27e3f66096f",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
