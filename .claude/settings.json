{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-check.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/before-request.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "fallbackModel": [
    "claude-sonnet-5",
    "claude-haiku-4-5"
  ]
}
